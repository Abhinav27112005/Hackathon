        {
            "name": "🎙️ Voice",
            "item": [
                {
                    "name": "1. Parse Profile from Voice 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"transcript\": \"Mera naam Ramesh hai. Main UP ke Lucknow mein rehta hoon. Mere paas 3 acre zameen hai aur main OBC category se hoon.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/voice/parse-profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "voice",
                                "parse-profile"
                            ]
                        },
                        "description": "Send a voice transcript to AI to extract and parse structured farmer profile data from it.\n\nBody: { transcript }\nResponse: { success, parsedProfile }"
                    }
                },
                {
                    "name": "2. Parse Query from Voice 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
