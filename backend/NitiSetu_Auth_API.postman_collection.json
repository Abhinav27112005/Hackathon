{
    "info": {
        "name": "NitiSetu Full API",
        "description": "Complete API collection for NitiSetu backend — all 33 routes across Auth, Profile, Schemes, Eligibility, Applications, Dashboard, Voice, and Example modules.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5000/api",
            "description": "Change to your Render URL when testing in production, e.g. https://your-app.onrender.com/api"
        },
        {
            "key": "token",
            "value": "YOUR_TOKEN_HERE",
            "description": "Paste the JWT token received after login or register"
        }
    ],
    "item": [
        {
            "name": "🏥 Base",
            "item": [
                {
                    "name": "1. API Root",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                ""
                            ]
                        },
                        "description": "Root endpoint — returns API welcome message and version"
                    }
                },
                {
                    "name": "2. Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/health",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "health"
                            ]
                        },
                        "description": "Check if API server is running and healthy"
                    }
                }
            ]
        },
        {
            "name": "🔐 Authentication",
            "item": [
                {
                    "name": "1. Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"phone\": \"9876543210\",\n  \"password\": \"test123\",\n  \"language\": \"hi\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Register a new user. Sends an OTP to the provided phone number.\n\nBody: { name, phone, password?, language? }\nResponse: { success, token, user, otp? }"
                    }
                },
                {
                    "name": "2. Send OTP (Resend)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"9876543210\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/send-otp",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "send-otp"
                            ]
                        },
                        "description": "Resend OTP to an existing user's phone number.\n\nBody: { phone }\nResponse: { success, message, otp? }"
                    }
                },
                {
                    "name": "3. Verify OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/verify-otp",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "verify-otp"
                            ]
                        },
                        "description": "Verify OTP sent to user's phone and mark them as verified.\n\nBody: { phone, otp }\nResponse: { success, token, user }"
                    }
                },
                {
                    "name": "4. Login with Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"9876543210\",\n  \"password\": \"test123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login using phone number and password.\n\nBody: { phone, password }\nResponse: { success, token, user }"
                    }
                },
                {
                    "name": "5. Get Current User (me) 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "description": "JWT token from login/register"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/me",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Get the currently authenticated user's info. Requires Bearer token.\n\nHeaders: Authorization: Bearer <token>\nResponse: { success, user }"
                    }
                },
                {
                    "name": "6. Logout 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "description": "JWT token from login/register"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Logout the current user (invalidates session). Client should delete the JWT token.\n\nResponse: { success, message }"
                    }
                }
            ]
        },
        {
            "name": "👤 Profile",
            "item": [
                {
                    "name": "1. Get Profile 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        },
                        "description": "Get the currently logged-in user's farmer profile.\n\nResponse: { success, profile }"
                    }
                },
                {
                    "name": "2. Create Profile 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"state\": \"Uttar Pradesh\",\n  \"district\": \"Lucknow\",\n  \"landHolding\": 2.5,\n  \"cropType\": [\"wheat\", \"rice\"],\n  \"annualIncome\": 80000,\n  \"category\": \"OBC\",\n  \"age\": 45,\n  \"gender\": \"male\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        },
                        "description": "Create a new farmer profile for the authenticated user.\n\nBody: farmer profile fields\nResponse: { success, profile }"
                    }
                },
                {
                    "name": "3. Update Profile 🔒",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"landHolding\": 3.0,\n  \"annualIncome\": 90000,\n  \"cropType\": [\"wheat\", \"sugarcane\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        },
                        "description": "Update the currently logged-in user's existing farmer profile.\n\nBody: fields to update\nResponse: { success, profile }"
                    }
                },
                {
                    "name": "4. Create Profile from Voice 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"transcript\": \"Mera naam Ramesh Kumar hai, main Uttar Pradesh ke Lucknow district mein rehta hoon. Mere paas 2.5 acre zameen hai aur main gehu aur chawal ugata hoon.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/profile/voice",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile",
                                "voice"
                            ]
                        },
                        "description": "Use AI to parse a voice transcript and create a farmer profile automatically.\n\nBody: { transcript }\nResponse: { success, profile, parsed }"
                    }
                }
            ]
        },
        {
            "name": "📄 Schemes",
            "item": [
                {
                    "name": "1. Upload Scheme (PDF) 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "pdfFile",
                                    "type": "file",
                                    "src": "",
                                    "description": "PDF file of the government scheme"
                                },
                                {
                                    "key": "title",
                                    "value": "PM Kisan Samman Nidhi",
                                    "type": "text"
                                },
                                {
                                    "key": "description",
                                    "value": "Financial support to farmer families",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/schemes/upload",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes",
                                "upload"
                            ]
                        },
                        "description": "Upload a government scheme PDF. The PDF will be processed in the background and indexed for RAG-based eligibility checking.\n\nBody: multipart/form-data with pdfFile + scheme metadata\nResponse: { success, scheme }"
                    }
                },
                {
                    "name": "2. Get All Schemes 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schemes",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes"
                            ]
                        },
                        "description": "List all uploaded government schemes.\n\nResponse: { success, count, schemes: [] }"
                    }
                },
                {
                    "name": "3. Get Scheme by ID 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schemes/SCHEME_ID_HERE",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes",
                                "SCHEME_ID_HERE"
                            ]
                        },
                        "description": "Get full details of a single scheme by its MongoDB ID.\n\nParams: :id — MongoDB ObjectId of the scheme\nResponse: { success, scheme }"
                    }
                },
                {
                    "name": "4. Get Scheme Processing Status 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schemes/SCHEME_ID_HERE/status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes",
                                "SCHEME_ID_HERE",
                                "status"
                            ]
                        },
                        "description": "Poll the processing status of a newly uploaded scheme PDF (pending / processing / completed / failed).\n\nParams: :id — MongoDB ObjectId of the scheme\nResponse: { success, status, progress }"
                    }
                },
                {
                    "name": "5. Reprocess Scheme 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schemes/SCHEME_ID_HERE/reprocess",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes",
                                "SCHEME_ID_HERE",
                                "reprocess"
                            ]
                        },
                        "description": "Retry processing for a scheme that failed during PDF extraction or indexing.\n\nParams: :id — MongoDB ObjectId of the scheme\nResponse: { success, message }"
                    }
                },
                {
                    "name": "6. Delete Scheme 🔒",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schemes/SCHEME_ID_HERE",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "schemes",
                                "SCHEME_ID_HERE"
                            ]
                        },
                        "description": "Permanently delete a scheme and all its associated RAG data.\n\nParams: :id — MongoDB ObjectId of the scheme\nResponse: { success, message }"
                    }
                }
            ]
        },
        {
            "name": "✅ Eligibility",
            "item": [
                {
                    "name": "1. Check Single Scheme Eligibility 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"schemeId\": \"SCHEME_ID_HERE\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/eligibility/check",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "eligibility",
                                "check"
                            ]
                        },
                        "description": "Check if the authenticated user is eligible for a specific scheme. Uses AI + RAG to evaluate against scheme PDF criteria.\n\nBody: { schemeId }\nResponse: { success, eligible, reason, details }"
                    }
                },
                {
                    "name": "2. Check All Schemes Eligibility 🔒",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/eligibility/check-all",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "eligibility",
                                "check-all"
                            ]
                        },
                        "description": "Check the authenticated user's eligibility against ALL available schemes at once.\n\nResponse: { success, results: [{ scheme, eligible, reason }] }"
                    }
                },
                {
                    "name": "3. Get Eligibility History 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/eligibility/history",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "eligibility",
                                "history"
                            ]
                        },
                        "description": "Get the full eligibility check history for the authenticated user.\n\nResponse: { success, count, history: [] }"
                    }
                },
                {
                    "name": "4. Get Eligibility Check by ID 🔒",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/eligibility/CHECK_ID_HERE",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "eligibility",
                                "CHECK_ID_HERE"
                            ]
                        },
                        "description": "Retrieve details of a specific past eligibility check by its ID.\n\nParams: :checkId — MongoDB ObjectId of the check record\nResponse: { success, check }"
                    }
                }
            ]
        },
        {
            "name": "📝 Applications",
            "item": [
